NEXT_PUBLIC_REGISTRATION_WEBHOOK_URL=https://your-webhook-endpoint.example.com

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Feature flag key used for the landing A/B experiment (created in PostHog UI).
# Defaults to "home-page-variant" if unset.
POSTHOG_LANDING_FLAG_KEY=home-page-variant
# Set to "true" to stop feeding server events to the dev-team PostHog project
# (the Cloudflare-proxied relay fan-out in src/lib/analytics/server.ts). When
# true, only the direct client/founder PostHog captures are sent. Defaults to
# relaying when the relay config is present.
# DISABLE_DEV_TEAM_PH=true

# PostHog dev bootstrap — used ONLY by `bun run bootstrap:posthog` to provision
# this app's dashboard suite (Overview, Conversion, Reliability — only events
# this app captures) via the admin REST API (see POSTHOG.md → PostHog
# bootstrap). PH_PERSONAL_API_KEY must be a phx_ personal API key with admin
# scope. PH_PROJECT_ID is optional — auto-discovered from the key's @current
# project when unset. PH_DASHBOARD_LABEL optionally suffixes every
# dashboard/insight with " — {label}" (e.g. "Overview — Workshop") so
# per-product suites coexist in one account. Keep the key secret.
PH_PROJECT_ID=103916
PH_PERSONAL_API_KEY="replace-with-phx-personal-api-key-with-admin-scope"
PH_HOST="https://us.i.posthog.com"
PH_DASHBOARD_LABEL=Workshop
